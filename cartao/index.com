<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Léo Vasconcellos · LeadVox</title>
<meta name="description" content="Cartão digital de Leonardo Vasconcellos, fundador e CEO da LeadVox. IA que atende, qualifica e agenda seus clientes no WhatsApp.">
<meta name="theme-color" content="#070d1c">
<meta property="og:title" content="Léo Vasconcellos · Fundador & CEO da LeadVox">
<meta property="og:description" content="Salve meu contato e veja a IA da LeadVox atendendo em segundos.">
<meta property="og:type" content="profile">
<link rel="icon" href="data:image/png;base64,">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,700&family=Syne:wght@700;800&display=swap" rel="stylesheet">
<style>
:root{
  --navy:#070d1c;--navy2:#0b1328;--navy3:#101d3a;--navy4:#162348;
  --green:#2be87b;--green2:#1fd06a;--glow:rgba(43,232,123,.2);--gdim:rgba(43,232,123,.08);
  --text:#e6edf8;--muted:#6b7fa8;--light:#a8b8d0;--border:rgba(255,255,255,.07);--card:rgba(255,255,255,.03);
  box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);
}
*,*::before,*::after{box-sizing:inherit;margin:0}
html{scroll-padding-top:env(safe-area-inset-top,0px);background:var(--navy)}
body{min-height:100%;background:var(--navy);color:var(--text);font-family:"DM Sans",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  font-size:16px;line-height:1.6;-webkit-font-smoothing:antialiased;overflow-x:hidden}
a{color:inherit;text-decoration:none}
.stripes{background:repeating-linear-gradient(-45deg,rgba(43,232,123,.07) 0,rgba(43,232,123,.07) 2px,transparent 2px,transparent 14px)}
.gr{background:linear-gradient(135deg,var(--green) 0%,#80ffc2 100%);-webkit-background-clip:text;background-clip:text;color:transparent}
.tag{display:block;font-size:.72rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--green);margin-bottom:10px}

.wrap{position:relative;max-width:460px;margin:0 auto;background:var(--navy);overflow:hidden}
@media (min-width:560px){
  body{padding:36px 0;background:radial-gradient(ellipse 60% 50% at 50% 0%,rgba(17,45,100,.55) 0%,transparent 60%),var(--navy)}
  .wrap{border:1px solid var(--border);border-radius:28px;box-shadow:0 40px 100px rgba(0,0,0,.5)}
}

/* top bar */
.top{position:relative;z-index:3;display:flex;justify-content:space-between;align-items:center;padding:18px 22px}
.top img{width:112px;height:auto}
.live{display:flex;align-items:center;gap:7px;font-size:.78rem;font-weight:500;color:var(--light);
  padding:6px 12px;border:1px solid var(--border);border-radius:999px;background:var(--card)}
.dot{width:7px;height:7px;border-radius:50%;background:var(--green);box-shadow:0 0 10px var(--green);animation:blink 1.6s infinite}

/* hero */
.hero{position:relative;height:450px;margin-top:-70px}
.hero-bg{position:absolute;inset:0;background:
  radial-gradient(ellipse 60% 50% at 50% 58%,rgba(43,232,123,.16) 0%,transparent 62%),
  radial-gradient(ellipse 70% 60% at 85% 15%,rgba(17,45,100,.7) 0%,transparent 60%),
  radial-gradient(ellipse 60% 50% at 10% 40%,rgba(22,35,72,.9) 0%,transparent 60%)}
.hero-stripe{position:absolute;right:0;top:0;bottom:0;width:42%;opacity:.55;-webkit-mask-image:linear-gradient(90deg,transparent,#000 60%);mask-image:linear-gradient(90deg,transparent,#000 60%)}
.ring{position:absolute;left:50%;top:50%;width:290px;height:290px;transform:translate(-50%,-50%);border-radius:50%;
  border:1px solid rgba(43,232,123,.22);box-shadow:0 0 80px rgba(43,232,123,.12),inset 0 0 60px rgba(43,232,123,.06)}
.ring::after{content:"";position:absolute;inset:26px;border-radius:50%;border:1px dashed rgba(43,232,123,.14)}
.person{position:absolute;left:50%;bottom:0;transform:translateX(-50%);width:min(84%,330px);height:auto;
  -webkit-mask-image:linear-gradient(180deg,#000 72%,transparent 100%);mask-image:linear-gradient(180deg,#000 72%,transparent 100%)}
.float{position:absolute;z-index:2;display:flex;align-items:center;gap:10px;padding:9px 13px 9px 10px;border-radius:14px;
  background:rgba(11,19,40,.78);border:1px solid rgba(43,232,123,.18);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);
  box-shadow:0 12px 30px rgba(0,0,0,.35);font-size:.78rem;line-height:1.25}
.float b{display:block;font-weight:700;color:var(--text)}
.float small{color:var(--muted);font-size:.72rem}
.float .fi{width:30px;height:30px;border-radius:9px;display:grid;place-items:center;background:var(--gdim);color:var(--green);flex:none}
.float .fi svg{width:17px;height:17px}
.f1{left:12px;top:258px;animation:floaty 5s ease-in-out infinite}
.f2{right:12px;top:74px;animation:floaty 5s 1.2s ease-in-out infinite}

/* identity */
.id{position:relative;z-index:2;padding:4px 22px 0}
h1{font-family:Syne,"DM Sans",sans-serif;font-weight:800;font-size:2.35rem;line-height:1.02;letter-spacing:-1.5px}
.pitch{margin-top:14px;color:var(--light);font-size:1.02rem;max-width:36ch}

.btn-primary{display:flex;align-items:center;justify-content:center;gap:10px;width:100%;padding:16px 20px;border-radius:12px;border:0;cursor:pointer;
  background:var(--green);color:#041020;font:700 1.03rem "DM Sans",sans-serif;box-shadow:0 0 26px rgba(43,232,123,.28);transition:transform .2s,box-shadow .2s,background .2s}
.btn-primary:hover{background:var(--green2);transform:translateY(-2px);box-shadow:0 0 44px rgba(43,232,123,.44)}
.btn-primary svg{width:21px;height:21px}
.btn-outline{display:flex;align-items:center;justify-content:center;gap:9px;width:100%;padding:14px 18px;border-radius:12px;
  border:1px solid rgba(43,232,123,.35);color:var(--text);font-weight:600;background:transparent;transition:border-color .2s,background .2s}
.btn-outline:hover{border-color:var(--green);background:var(--gdim)}
.btn-outline svg{width:19px;height:19px;color:var(--green)}
.save{margin:22px 22px 0;width:auto}

/* contatos */
.contacts{display:grid;grid-template-columns:repeat(3,1fr);gap:3px;margin:14px 22px 0;background:var(--border);border-radius:16px;overflow:hidden}
.contacts a{display:flex;flex-direction:column;align-items:center;gap:8px;padding:16px 6px 14px;background:var(--navy2);font-size:.82rem;font-weight:500;color:var(--light);transition:background .2s}
.contacts a:hover{background:var(--navy3)}
.ci{width:44px;height:44px;border-radius:13px;display:grid;place-items:center;background:var(--gdim);border:1px solid rgba(43,232,123,.15);color:var(--green)}
.ci svg{width:22px;height:22px}
.num{margin:12px 22px 0;text-align:center;color:var(--muted);font-size:.84rem}
.num span{color:var(--light)}

/* números */
.stats{display:grid;grid-template-columns:repeat(3,1fr);margin:30px 22px 0;padding:18px 0;border-top:1px solid var(--border);border-bottom:1px solid var(--border)}
.stat{text-align:center}
.stat+.stat{border-left:1px solid var(--border)}
.stat b{display:block;font-family:Syne,sans-serif;font-weight:800;font-size:1.5rem;letter-spacing:-.5px;color:var(--text)}
.stat span{font-size:.74rem;color:var(--muted);line-height:1.3;display:block;margin-top:2px}

/* marquee */
.marquee{margin-top:26px;overflow:hidden;-webkit-mask-image:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent);mask-image:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent)}
.track{display:flex;gap:10px;width:max-content;animation:slide 26s linear infinite}
.chip{display:flex;align-items:center;gap:7px;padding:8px 14px;border-radius:999px;border:1px solid var(--border);background:var(--card);font-size:.82rem;color:var(--light);white-space:nowrap}
.chip i{width:6px;height:6px;border-radius:50%;background:var(--green)}

/* IA */
.ia{position:relative;margin-top:40px;padding:36px 22px 30px;background:var(--navy2);border-top:1px solid rgba(43,232,123,.1);border-bottom:1px solid rgba(43,232,123,.1)}
.ia::before{content:"";position:absolute;left:50%;top:48%;width:420px;height:420px;transform:translate(-50%,-50%);background:radial-gradient(ellipse,rgba(43,232,123,.08) 0%,transparent 65%);pointer-events:none}
.ia h2{position:relative;font-family:Syne,sans-serif;font-weight:800;font-size:1.65rem;line-height:1.1;letter-spacing:-1px}
.ia .lead{position:relative;margin-top:10px;color:var(--light)}
.phone{position:relative;margin:24px auto 40px;max-width:340px;border-radius:30px;padding:8px;background:linear-gradient(160deg,#1b2a52,#0a1226);
  border:1px solid rgba(255,255,255,.1);box-shadow:0 30px 60px rgba(0,0,0,.45),0 0 60px rgba(43,232,123,.08)}
.screen{border-radius:23px;overflow:hidden;background:#060c18}
.ch-head{display:flex;align-items:center;gap:10px;padding:14px 14px 12px;background:#0b1530;border-bottom:1px solid var(--border)}
.av{width:34px;height:34px;border-radius:50%;background:var(--navy3);display:grid;place-items:center;border:1.5px solid var(--green)}
.av img{width:25px;height:auto}
.ch-head b{display:block;font-size:.88rem}
.ch-head small{display:flex;align-items:center;gap:6px;color:var(--green);font-size:.72rem;line-height:1.2}
.chat{padding:14px 11px 64px;min-height:400px;display:flex;flex-direction:column;gap:8px}
.msg{max-width:84%;padding:8px 11px 6px;border-radius:13px;font-size:.86rem;line-height:1.4}
.msg time{display:block;text-align:right;font-size:.64rem;color:rgba(255,255,255,.35);margin-top:2px}
.in{align-self:flex-end;background:#1d6b47;border-bottom-right-radius:3px}
.bot{align-self:flex-start;background:#122038;border-bottom-left-radius:3px}
.typing{align-self:flex-start;background:#122038;border-radius:13px;padding:10px 13px;display:none;gap:4px}
.typing i{width:6px;height:6px;border-radius:50%;background:var(--light);opacity:.35}
.js .msg{display:none}
.js .msg.show{display:block;animation:pop .28s ease-out}
.typing.show{display:flex}
.typing.show i{animation:blink 1s infinite}.typing.show i:nth-child(2){animation-delay:.15s}.typing.show i:nth-child(3){animation-delay:.3s}
.notif{position:absolute;left:50%;bottom:-26px;transform:translate(-50%,12px);width:calc(100% - 28px);opacity:0;pointer-events:none;
  display:flex;gap:11px;align-items:center;padding:11px 13px;border-radius:16px;background:rgba(16,29,58,.92);border:1px solid rgba(43,232,123,.25);
  backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);box-shadow:0 14px 36px rgba(0,0,0,.45);transition:opacity .35s,transform .35s;font-size:.8rem;line-height:1.3}
.notif.show{opacity:1;transform:translate(-50%,0)}
.notif .fi{width:32px;height:32px;border-radius:10px;display:grid;place-items:center;background:var(--green);color:#041020;flex:none}
.notif .fi svg{width:18px;height:18px}
.notif small{color:var(--muted)}
.facts{position:relative;list-style:none;padding:0;margin-top:10px;display:grid;gap:12px}
.facts li{display:flex;gap:12px;align-items:flex-start;color:var(--light);font-size:.95rem;line-height:1.45}
.facts li b{color:var(--text);font-weight:600}
.facts .fi{flex:none;width:28px;height:28px;border-radius:8px;display:grid;place-items:center;background:var(--gdim);border:1px solid rgba(43,232,123,.15);color:var(--green)}
.facts .fi svg{width:15px;height:15px}
.ctas{position:relative;display:grid;gap:10px;margin-top:26px}

/* rodapé */
.foot{display:flex;gap:10px;margin:26px 22px 0}
.foot button{flex:1;font:500 .92rem "DM Sans",sans-serif;color:var(--light);background:var(--card);border:1px solid var(--border);border-radius:12px;
  padding:12px 10px;display:flex;align-items:center;justify-content:center;gap:8px;cursor:pointer;transition:border-color .2s,color .2s}
.foot button:hover{border-color:rgba(43,232,123,.35);color:var(--text)}
.foot svg{width:18px;height:18px}
.brand{display:flex;flex-direction:column;align-items:center;gap:8px;padding:30px 22px 34px;color:var(--muted);font-size:.78rem;text-align:center}
.brand img{width:130px;height:auto;opacity:.9}

a:focus-visible,button:focus-visible{outline:2px solid var(--green);outline-offset:3px;border-radius:12px}

/* QR */
dialog{border:1px solid rgba(43,232,123,.2);border-radius:22px;padding:26px 22px 20px;max-width:320px;width:calc(100% - 40px);text-align:center;background:var(--navy2);color:var(--text)}
dialog::backdrop{background:rgba(3,6,14,.8);backdrop-filter:blur(4px)}
dialog h3{font-family:Syne,sans-serif;font-weight:800;font-size:1.2rem;letter-spacing:-.5px}
dialog p{margin:4px 0 16px;font-size:.88rem;color:var(--muted)}
#qr{display:grid;place-items:center;min-height:236px;background:#fff;border-radius:16px;padding:8px}
#qr img,#qr canvas{width:220px!important;height:220px!important}
dialog button{margin-top:16px}
.toast{position:fixed;left:50%;bottom:calc(24px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);background:var(--green);color:#041020;
  font-weight:700;padding:11px 18px;border-radius:12px;opacity:0;pointer-events:none;transition:opacity .2s;box-shadow:0 0 26px rgba(43,232,123,.35)}
.toast.on{opacity:1}

/* reveal */
.js .rv{opacity:0;transform:translateY(22px);transition:opacity .7s ease,transform .7s ease}
.js .rv.in-view{opacity:1;transform:none}
.hero .person,.hero .ring{animation:fadeUp .8s .05s ease both}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.25}}
@keyframes fadeUp{from{opacity:0;transform:translate(-50%,22px)}to{opacity:1;transform:translate(-50%,0)}}
.hero .ring{animation-name:ringIn}
@keyframes ringIn{from{opacity:0;transform:translate(-50%,-50%) scale(.9)}to{opacity:1;transform:translate(-50%,-50%) scale(1)}}
@keyframes floaty{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}
@keyframes pop{from{opacity:0;transform:translateY(6px) scale(.97)}to{opacity:1;transform:none}}
@keyframes slide{to{transform:translateX(-50%)}}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}.js .rv{opacity:1;transform:none}}
</style>
</head>
<body>
<main class="wrap">
  <header class="top">
    <img src="data:image/png;base64," alt="LeadVox" width="112" height="37">
    <span class="live"><span class="dot"></span>IA online agora</span>
  </header>

  <section class="hero" aria-label="Foto">
    <div class="hero-bg"></div>
    <div class="hero-stripe stripes"></div>
    <div class="ring"></div>
    <img class="person" src="data:image/webp;base64," alt="Léo Vasconcellos, fundador e CEO da LeadVox" width="472" height="533">
    <div class="float f2">
      <span class="fi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2 4 14h7l-1 8 9-12h-7z"/></svg></span>
      <span><b>Resposta em 3s</b><small>24h por dia</small></span>
    </div>
    <div class="float f1">
      <span class="fi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></span>
      <span><b>Lead qualificado</b><small>agora mesmo</small></span>
    </div>
  </section>

  <section class="id">
    <span class="tag">Fundador &amp; CEO · LeadVox</span>
    <h1>Léo <span class="gr">Vasconcellos</span></h1>
    <p class="pitch">Coloco uma IA para atender, qualificar e agendar os clientes da sua empresa no WhatsApp, 24 horas por dia.</p>
  </section>

  <a class="btn-primary save" id="btn-save" href="#">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M19 8v6M22 11h-6"/></svg>
    Salvar contato
  </a>

  <nav class="contacts" aria-label="Contatos">
    <a id="lnk-wa" href="#" target="_blank" rel="noopener"><span class="ci"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.4.8 3.2.6a2.8 2.8 0 0 0 1.8-1.3 2.3 2.3 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3Z"/></svg></span>WhatsApp</a>
    <a id="lnk-mail" href="#"><span class="ci"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></span>E-mail</a>
    <a id="lnk-site" href="#" target="_blank" rel="noopener"><span class="ci"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></svg></span>Site</a>
  </nav>
  <p class="num"><span id="txt-wa"></span> · <span id="txt-mail"></span></p>

  <div class="stats rv">
    <div class="stat"><b data-count="100" data-prefix="+">+100</b><span>empresas atendidas</span></div>
    <div class="stat"><b data-count="1000" data-prefix="+">+1.000</b><span>usuários ativos</span></div>
    <div class="stat"><b>24h</b><span>IA atendendo</span></div>
  </div>

  <div class="marquee" aria-hidden="true">
    <div class="track">
      <span class="chip"><i></i>WhatsApp</span><span class="chip"><i></i>Instagram</span><span class="chip"><i></i>Facebook</span><span class="chip"><i></i>Webchat</span><span class="chip"><i></i>Ligação VoIP</span><span class="chip"><i></i>CRM</span><span class="chip"><i></i>Agendamento</span><span class="chip"><i></i>E-mail</span>
      <span class="chip"><i></i>WhatsApp</span><span class="chip"><i></i>Instagram</span><span class="chip"><i></i>Facebook</span><span class="chip"><i></i>Webchat</span><span class="chip"><i></i>Ligação VoIP</span><span class="chip"><i></i>CRM</span><span class="chip"><i></i>Agendamento</span><span class="chip"><i></i>E-mail</span>
    </div>
  </div>

  <section class="ia" aria-labelledby="ia-t">
    <div class="rv">
      <span class="tag">IA LeadVox em ação</span>
      <h2 id="ia-t">Seu cliente chamou às 21h47. <span class="gr">A IA respondeu às 21h47.</span></h2>
      <p class="lead">Ela atende no WhatsApp da sua empresa com o seu jeito de vender, e entrega o cliente pronto pro vendedor.</p>
    </div>

    <div class="phone rv">
      <div class="screen">
        <div class="ch-head">
          <span class="av"><img src="data:image/png;base64," alt=""></span>
          <span><b>Sua empresa</b><small><span class="dot"></span>IA LeadVox · online</small></span>
        </div>
        <div class="chat" id="chat" aria-label="Exemplo de conversa com a IA">
          <div class="msg in">Boa noite! O HB20 2022 ainda tá disponível?<time>21:47</time></div>
          <div class="msg bot">Boa noite! Tá sim 😊 Ele tem 38 mil km e já está revisado. Você pensa em financiar ou pagar à vista?<time>21:47</time></div>
          <div class="msg in">Financiar. Tenho um carro pra dar de entrada.<time>21:48</time></div>
          <div class="msg bot">Perfeito! Posso agendar a avaliação do seu carro amanhã? Tenho horário às 10h ou às 15h.<time>21:48</time></div>
          <div class="msg in">15h fica ótimo 👍<time>21:48</time></div>
          <div class="msg bot">Agendado! ✅ Você recebe a confirmação por aqui.<time>21:48</time></div>
          <div class="typing" aria-hidden="true"><i></i><i></i><i></i></div>
        </div>
      </div>
      <div class="notif" id="notif" aria-hidden="true">
        <span class="fi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg></span>
        <span><b>Visita agendada · amanhã às 15h</b><br><small>Lead registrado no CRM e enviado ao vendedor</small></span>
      </div>
    </div>

    <ul class="facts rv">
      <li><span class="fi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></span><span><b>Responde em segundos</b>, inclusive de madrugada e no fim de semana</span></li>
      <li><span class="fi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></span><span><b>Qualifica e agenda</b> visita ou reunião sozinha</span></li>
      <li><span class="fi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></span><span><b>Tudo registrado no CRM</b>, com o lead pronto pro vendedor</span></li>
      <li><span class="fi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></span><span><b>Uma plataforma só</b> para WhatsApp, Instagram, Facebook, site e ligação</span></li>
    </ul>

    <div class="ctas rv">
      <a class="btn-primary" id="lnk-ia" href="#" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        Testar a IA no WhatsApp
      </a>
      <a class="btn-outline" id="lnk-wa2" href="#" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Z"/></svg>
        Falar com o Léo
      </a>
    </div>
  </section>

  <div class="foot">
    <button type="button" id="btn-qr"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><path d="M14 14h3v3h-3zM20 14v.01M14 20h.01M17 20h4v-3"/></svg>QR code</button>
    <button type="button" id="btn-share"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.6 13.5 6.8 4M15.4 6.5l-6.8 4"/></svg>Compartilhar</button>
  </div>

  <footer class="brand">
    <img src="data:image/png;base64," alt="LeadVox" width="130" height="43">
    Marketing e Automação com IA · Plataforma Omnichannel
  </footer>
</main>

<dialog id="dlg" aria-labelledby="dlg-t">
  <h3 id="dlg-t">Aponte a câmera</h3>
  <p>O cartão abre direto no celular de quem escanear.</p>
  <div id="qr"></div>
  <button type="button" class="btn-primary" id="dlg-close">Fechar</button>
</dialog>
<div class="toast" id="toast" role="status">Link copiado</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script>
/* ===== EDITE AQUI ===== */
const CONFIG = {
  whatsLeo:  "5521981081044",   // seu WhatsApp
  whatsIA:   "5521981081044",   // número onde a IA da LeadVox atende
  email:     "contato@leadvox.com.br",
  site:      "https://leadvox.com.br",
  msgLeo:    "Oi Léo! Peguei seu cartão digital e quero conversar sobre a LeadVox.",
  msgIA:     "Oi! Vim pelo cartão do Léo e quero ver a IA da LeadVox funcionando."
};
/* ====================== */
document.documentElement.classList.add('js');
const $ = id => document.getElementById(id);
const fmt = n => { const d=n.replace(/^55/,''); return `(${d.slice(0,2)}) ${d.slice(2,7)}-${d.slice(7)}`; };
const wa = (n,t) => `https://wa.me/${n}?text=${encodeURIComponent(t)}`;
$('lnk-wa').href = $('lnk-wa2').href = wa(CONFIG.whatsLeo, CONFIG.msgLeo);
$('lnk-ia').href = wa(CONFIG.whatsIA, CONFIG.msgIA);
$('lnk-mail').href = 'mailto:' + CONFIG.email;
$('lnk-site').href = CONFIG.site;
$('txt-wa').textContent = fmt(CONFIG.whatsLeo);
$('txt-mail').textContent = CONFIG.email;
const pageUrl = location.href.split('#')[0];
const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
const hasIO = 'IntersectionObserver' in window;

/* salvar contato: gera o vCard dentro da própria página */
const VCF_PHOTO = "";
function buildVcf(){
  const d=CONFIG.whatsLeo.replace(/^55/,'');
  const fold=s=>{let o=s.slice(0,75);for(let i=75;i<s.length;i+=74)o+="\r\n "+s.slice(i,i+74);return o;};
  return ["BEGIN:VCARD","VERSION:3.0","N:Vasconcellos;Leonardo;;;","FN:Leonardo Vasconcellos (Léo)","ORG:LeadVox","TITLE:Fundador & CEO",
    `TEL;TYPE=CELL,VOICE:+55 ${d.slice(0,2)} ${d.slice(2,7)}-${d.slice(7)}`,"EMAIL;TYPE=WORK:"+CONFIG.email,"URL:"+CONFIG.site,
    "ADR;TYPE=WORK:;;;Rio de Janeiro;RJ;;Brasil","NOTE:LeadVox - Marketing e Automação com IA / Plataforma Omnichannel",
    fold("PHOTO;ENCODING=b;TYPE=JPEG:"+VCF_PHOTO),"END:VCARD"].join("\r\n")+"\r\n";
}
$('btn-save').addEventListener('click',e=>{
  e.preventDefault();
  const blob=new Blob([buildVcf()],{type:'text/vcard;charset=utf-8'});
  const iOS=/iP(hone|ad|od)/.test(navigator.userAgent)||(navigator.platform==='MacIntel'&&navigator.maxTouchPoints>1);
  if(iOS){ const r=new FileReader(); r.onload=()=>{ location.href=r.result; }; r.readAsDataURL(blob); return; }
  const url=URL.createObjectURL(blob), a=document.createElement('a');
  a.href=url; a.download='Leo-Vasconcellos-LeadVox.vcf'; document.body.appendChild(a); a.click(); a.remove();
  setTimeout(()=>URL.revokeObjectURL(url),5000);
});

/* revelar ao rolar + contadores */
function countUp(el){
  const end=+el.dataset.count, pre=el.dataset.prefix||'', t0=performance.now(), dur=1200;
  const step=t=>{ const p=Math.min((t-t0)/dur,1), v=Math.round(end*(1-Math.pow(1-p,3)));
    el.textContent=pre+v.toLocaleString('pt-BR'); if(p<1) requestAnimationFrame(step); };
  requestAnimationFrame(step);
}
const rvs=document.querySelectorAll('.rv');
if(reduce || !hasIO){ rvs.forEach(r=>r.classList.add('in-view')); }
else{
  const io=new IntersectionObserver(es=>es.forEach(e=>{ if(e.isIntersecting){ e.target.classList.add('in-view');
    e.target.querySelectorAll('[data-count]').forEach(countUp); io.unobserve(e.target);} }),{threshold:.2});
  rvs.forEach(r=>io.observe(r));
}

/* conversa animada: toca uma vez quando aparece na tela */
(function(){
  const msgs=[...document.querySelectorAll('.chat .msg')], typing=document.querySelector('.typing'), notif=$('notif');
  const showAll=()=>{ msgs.forEach(m=>m.classList.add('show')); notif.classList.add('show'); };
  if(reduce || !hasIO){ showAll(); return; }
  let played=false;
  const wait=ms=>new Promise(r=>setTimeout(r,ms));
  const play=async()=>{
    await wait(400);
    for(const m of msgs){
      if(m.classList.contains('bot')){ m.before(typing); typing.classList.add('show'); await wait(1100); typing.classList.remove('show'); }
      else await wait(700);
      m.classList.add('show');
    }
    await wait(600); notif.classList.add('show');
  };
  new IntersectionObserver((es,o)=>{ if(es[0].isIntersecting && !played){ played=true; o.disconnect(); play(); } },{threshold:.35}).observe($('chat'));
})();

/* QR code */
const dlg=$('dlg');
$('btn-qr').addEventListener('click',()=>{
  const box=$('qr');
  if(!box.dataset.done){
    if(window.QRCode){ new QRCode(box,{text:pageUrl,width:440,height:440,colorDark:'#070d1c',colorLight:'#ffffff',correctLevel:QRCode.CorrectLevel.M}); }
    else { box.textContent = pageUrl; }
    box.dataset.done='1';
  }
  if(dlg.showModal) dlg.showModal(); else dlg.setAttribute('open','');
});
$('dlg-close').addEventListener('click',()=>dlg.close ? dlg.close() : dlg.removeAttribute('open'));
dlg.addEventListener('click',e=>{ if(e.target===dlg) dlg.close(); });

/* compartilhar */
$('btn-share').addEventListener('click',async()=>{
  const data={title:'Léo Vasconcellos · LeadVox',text:'Meu cartão digital',url:pageUrl};
  if(navigator.share){ try{ await navigator.share(data); }catch(e){} return; }
  try{ await navigator.clipboard.writeText(pageUrl); }catch(e){}
  const t=$('toast'); t.classList.add('on'); setTimeout(()=>t.classList.remove('on'),1800);
});
</script>
</body>
</html>
