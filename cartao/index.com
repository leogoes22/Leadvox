<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Léo Vasconcellos · LeadVox</title>
<meta name="description" content="Cartão digital de Leonardo Vasconcellos, fundador e CEO da LeadVox — IA que atende, qualifica e agenda seus clientes no WhatsApp.">
<meta name="theme-color" content="#060A76">
<meta property="og:title" content="Léo Vasconcellos · Fundador & CEO da LeadVox">
<meta property="og:description" content="Salve meu contato e veja a IA da LeadVox atendendo em segundos.">
<meta property="og:image" content="https://leadvox.com.br/cartao/leo-leadvox.jpg">
<meta property="og:type" content="profile">
<link rel="icon" href="data:image/png;base64,">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,700&family=Syne:wght@600;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --navy:#060A76; --deep:#02043A; --ink:#0B1060; --green:#3DAF35; --lime:#2BE87B;
  --white:#FFFFFF; --soft:#B9C0FF; --line:rgba(255,255,255,.12);
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
}
*,*::before,*::after{box-sizing:inherit}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;min-height:100%;background:var(--deep);color:var(--white);
  font-family:"DM Sans",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;font-size:16px;line-height:1.5;
  -webkit-font-smoothing:antialiased}
a{color:inherit}
.card{max-width:440px;margin:0 auto;background:linear-gradient(180deg,var(--navy) 0%,var(--ink) 55%,var(--deep) 100%);min-height:100vh;overflow:hidden}
@media (min-width:520px){body{padding:32px 0}.card{border-radius:32px;min-height:auto;box-shadow:0 30px 80px rgba(0,0,0,.45)}}

/* hero */
.photo{display:block;width:100%;height:auto;aspect-ratio:1/1;object-fit:cover}
.id{padding:22px 24px 6px}
.name{font-family:Syne,"DM Sans",sans-serif;font-weight:800;font-size:2rem;line-height:1.05;letter-spacing:-.02em;margin:0}
.role{margin:8px 0 0;color:var(--soft);font-size:1rem}
.pitch{margin:14px 0 0;font-size:1.05rem;max-width:34ch}

/* actions */
.save{display:flex;align-items:center;justify-content:center;gap:10px;margin:22px 24px 0;padding:17px 20px;border-radius:16px;
  background:var(--lime);color:#03183A;font-weight:700;font-size:1.08rem;text-decoration:none;
  box-shadow:0 10px 30px rgba(43,232,123,.28)}
.save svg{width:22px;height:22px}
.list{list-style:none;margin:18px 24px 0;padding:0;border-top:1px solid var(--line)}
.list li{border-bottom:1px solid var(--line)}
.list a{display:flex;align-items:center;gap:14px;padding:15px 2px;text-decoration:none}
.ico{flex:none;width:42px;height:42px;border-radius:12px;display:grid;place-items:center;background:rgba(255,255,255,.08)}
.ico svg{width:22px;height:22px}
.lbl{display:flex;flex-direction:column;min-width:0}
.lbl small{color:var(--soft);font-size:.82rem}
.lbl span{font-weight:500;overflow-wrap:anywhere}

/* IA */
.ia{margin:34px 16px 0;padding:24px 18px 20px;border-radius:26px;background:rgba(255,255,255,.05);border:1px solid var(--line)}
.ia h2{font-family:Syne,sans-serif;font-weight:700;font-size:1.45rem;line-height:1.15;margin:0 6px}
.ia p.lead{margin:10px 6px 18px;color:var(--soft)}
.chat{background:#0A0F2E;border-radius:18px;padding:14px 12px 16px;min-height:318px;display:flex;flex-direction:column;gap:8px}
.chat-top{display:flex;align-items:center;gap:10px;padding:0 4px 10px;border-bottom:1px solid var(--line);margin-bottom:4px}
.chat-top b{font-size:.92rem}
.chat-top small{display:block;color:var(--lime);font-size:.76rem;line-height:1.2}
.av{width:32px;height:32px;border-radius:50%;background:var(--navy);display:grid;place-items:center;border:1.5px solid var(--green)}
.av img{width:24px}
.msg{max-width:84%;padding:8px 11px 6px;border-radius:14px;font-size:.93rem;line-height:1.35}
.msg time{display:block;text-align:right;font-size:.68rem;opacity:.6;margin-top:2px}
.in{align-self:flex-start;background:#1C2250;border-top-left-radius:4px}
.out{align-self:flex-end;background:#0F5A3A;border-top-right-radius:4px}
.typing{align-self:flex-end;background:#0F5A3A;border-radius:14px;padding:10px 13px;display:none;gap:4px}
.typing i{width:6px;height:6px;border-radius:50%;background:#bff5d6;opacity:.5}
.js .msg{display:none}
.js .msg.show{display:block;animation:pop .28s ease-out}
.typing.show{display:flex}
.typing.show i{animation:blink 1s infinite}
.typing.show i:nth-child(2){animation-delay:.15s}.typing.show i:nth-child(3){animation-delay:.3s}
@keyframes pop{from{opacity:0;transform:translateY(6px) scale(.97)}to{opacity:1;transform:none}}
@keyframes blink{50%{opacity:1}}
.facts{list-style:none;margin:18px 6px 0;padding:0;display:grid;gap:10px}
.facts li{display:flex;gap:10px;align-items:flex-start;font-size:.97rem}
.facts svg{flex:none;width:20px;height:20px;margin-top:2px;color:var(--lime)}
.try{display:flex;align-items:center;justify-content:center;gap:10px;margin:20px 0 0;padding:15px;border-radius:14px;
  border:1.5px solid var(--lime);color:var(--lime);font-weight:700;text-decoration:none}
.try svg{width:20px;height:20px}

/* footer */
.foot{display:flex;gap:10px;margin:26px 24px 0}
.foot button{flex:1;font:inherit;font-weight:500;color:var(--white);background:rgba(255,255,255,.07);border:1px solid var(--line);
  border-radius:14px;padding:13px 10px;display:flex;align-items:center;justify-content:center;gap:8px;cursor:pointer}
.foot svg{width:19px;height:19px}
.brand{display:flex;flex-direction:column;align-items:center;gap:6px;padding:30px 24px 34px;color:var(--soft);font-size:.8rem;text-align:center}
.brand img{width:150px;height:auto}
.av img{height:auto}

a:focus-visible,button:focus-visible{outline:3px solid var(--lime);outline-offset:3px;border-radius:14px}

/* QR modal */
dialog{border:0;border-radius:24px;padding:26px 22px 20px;max-width:320px;width:calc(100% - 40px);text-align:center;color:#0B1060}
dialog::backdrop{background:rgba(2,4,58,.75)}
dialog h3{font-family:Syne,sans-serif;margin:0 0 4px;font-size:1.2rem}
dialog p{margin:0 0 16px;font-size:.9rem;color:#4a5080}
#qr{display:grid;place-items:center;min-height:220px}
#qr img,#qr canvas{width:220px!important;height:220px!important}
dialog button{margin-top:16px;font:inherit;font-weight:700;background:var(--navy);color:#fff;border:0;border-radius:12px;padding:12px 22px;cursor:pointer}
.toast{position:fixed;left:50%;bottom:calc(24px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);background:var(--lime);color:#03183A;
  font-weight:700;padding:11px 18px;border-radius:12px;opacity:0;pointer-events:none;transition:opacity .2s}
.toast.on{opacity:1}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
</head>
<body>
<main class="card">
  <img class="photo" src="data:image/jpeg;base64," alt="Léo Vasconcellos, fundador e CEO da LeadVox" width="480" height="480">

  <section class="id">
    <h1 class="name">Léo Vasconcellos</h1>
    <p class="role">Fundador &amp; CEO da LeadVox · Rio de Janeiro</p>
    <p class="pitch">Coloco uma IA para atender, qualificar e agendar os clientes da sua empresa no WhatsApp, 24 horas por dia.</p>
  </section>

  <a class="save" href="leo.vcf" download="Leo-Vasconcellos-LeadVox.vcf">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M19 8v6M22 11h-6"/></svg>
    Salvar contato
  </a>

  <ul class="list">
    <li><a id="lnk-wa" href="#" target="_blank" rel="noopener">
      <span class="ico"><svg viewBox="0 0 24 24" fill="#2BE87B" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.4.8 3.2.6a2.8 2.8 0 0 0 1.8-1.3 2.3 2.3 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3Z"/></svg></span>
      <span class="lbl"><small>Meu WhatsApp</small><span id="txt-wa"></span></span></a></li>
    <li><a id="lnk-mail" href="#">
      <span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></span>
      <span class="lbl"><small>E-mail</small><span id="txt-mail"></span></span></a></li>
    <li><a id="lnk-site" href="#" target="_blank" rel="noopener">
      <span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></svg></span>
      <span class="lbl"><small>Site</small><span id="txt-site"></span></span></a></li>
  </ul>

  <section class="ia" aria-labelledby="ia-t">
    <h2 id="ia-t">Seu cliente mandou mensagem às 21h47. A IA respondeu às 21h47.</h2>
    <p class="lead">É assim que a IA da LeadVox atende no WhatsApp da sua empresa: na hora, com o seu jeito de vender.</p>

    <div class="chat" id="chat" aria-label="Exemplo de conversa com a IA">
      <div class="chat-top">
        <span class="av"><img src="data:image/png;base64," alt=""></span>
        <span><b>Sua empresa</b><small>IA LeadVox · online</small></span>
      </div>
      <div class="msg in">Boa noite! O HB20 2022 ainda tá disponível?<time>21:47</time></div>
      <div class="msg out">Boa noite! Tá sim 😊 Ele tem 38 mil km e já está revisado. Você pensa em financiar ou pagar à vista?<time>21:47</time></div>
      <div class="msg in">Financiar. Tenho um carro pra dar de entrada.<time>21:48</time></div>
      <div class="msg out">Perfeito! Posso agendar a avaliação do seu carro amanhã? Tenho horário às 10h ou às 15h.<time>21:48</time></div>
      <div class="msg in">15h fica ótimo 👍<time>21:48</time></div>
      <div class="msg out">Agendado! Seu atendimento já está com o vendedor, e você recebe a confirmação por aqui ✅<time>21:48</time></div>
      <div class="typing" aria-hidden="true"><i></i><i></i><i></i></div>
    </div>

    <ul class="facts">
      <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>Responde em segundos, inclusive de madrugada e no fim de semana</li>
      <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>Qualifica o cliente e marca visita ou reunião sozinha</li>
      <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>Passa o lead pronto pro vendedor, com tudo registrado no CRM</li>
      <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>WhatsApp, Instagram, Facebook, site e ligação na mesma plataforma</li>
    </ul>

    <a class="try" id="lnk-ia" href="#" target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      Testar a IA no WhatsApp
    </a>
  </section>

  <div class="foot">
    <button type="button" id="btn-qr"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><path d="M14 14h3v3h-3zM20 14v.01M14 20h.01M17 20h4v-3"/></svg>QR code</button>
    <button type="button" id="btn-share"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.6 13.5 6.8 4M15.4 6.5l-6.8 4"/></svg>Compartilhar</button>
  </div>

  <footer class="brand">
    <img src="data:image/png;base64," alt="LeadVox" width="150" height="50">
    Marketing e Automação com IA · Plataforma Omnichannel
  </footer>
</main>

<dialog id="dlg" aria-labelledby="dlg-t">
  <h3 id="dlg-t">Aponte a câmera</h3>
  <p>O cartão abre direto no celular de quem escanear.</p>
  <div id="qr"></div>
  <button type="button" id="dlg-close">Fechar</button>
</dialog>
<div class="toast" id="toast" role="status">Link copiado</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script>
/* ===== EDITE AQUI ===== */
const CONFIG = {
  whatsLeo:  "5521981081044",   // seu WhatsApp
  whatsIA:   "5521981081044",   // número onde a IA da LeadVox atende
  email:     "leogoesvendasrj@gmail.com",
  site:      "https://leadvox.com.br",
  msgLeo:    "Oi Léo! Peguei seu cartão digital e quero conversar sobre a LeadVox.",
  msgIA:     "Oi! Vim pelo cartão do Léo e quero ver a IA da LeadVox funcionando."
};
/* ====================== */
document.documentElement.classList.add('js');
const $ = id => document.getElementById(id);
const fmt = n => { const d=n.replace(/^55/,''); return `(${d.slice(0,2)}) ${d.slice(2,7)}-${d.slice(7)}`; };
const wa = (n,t) => `https://wa.me/${n}?text=${encodeURIComponent(t)}`;
$('lnk-wa').href = wa(CONFIG.whatsLeo, CONFIG.msgLeo);  $('txt-wa').textContent = fmt(CONFIG.whatsLeo);
$('lnk-ia').href = wa(CONFIG.whatsIA, CONFIG.msgIA);
$('lnk-mail').href = 'mailto:' + CONFIG.email;           $('txt-mail').textContent = CONFIG.email;
$('lnk-site').href = CONFIG.site;                        $('txt-site').textContent = CONFIG.site.replace(/^https?:\/\//,'');

const pageUrl = location.href.split('#')[0];

/* conversa animada: toca uma vez quando aparece na tela */
(function(){
  const msgs=[...document.querySelectorAll('.chat .msg')], typing=document.querySelector('.typing');
  const reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;
  const showAll=()=>msgs.forEach(m=>m.classList.add('show'));
  if(reduce || !('IntersectionObserver' in window)){ showAll(); return; }
  let played=false;
  const play=async()=>{
    const wait=ms=>new Promise(r=>setTimeout(r,ms));
    for(const m of msgs){
      if(m.classList.contains('out')){ m.before(typing); typing.classList.add('show'); await wait(1100); typing.classList.remove('show'); }
      else await wait(650);
      m.classList.add('show');
    }
  };
  new IntersectionObserver((es,o)=>{ if(es[0].isIntersecting && !played){ played=true; o.disconnect(); play(); } },{threshold:.35}).observe($('chat'));
})();

/* QR code */
const dlg=$('dlg');
$('btn-qr').addEventListener('click',()=>{
  const box=$('qr');
  if(!box.dataset.done){
    if(window.QRCode){ new QRCode(box,{text:pageUrl,width:440,height:440,colorDark:'#060A76',colorLight:'#ffffff',correctLevel:QRCode.CorrectLevel.M}); }
    else { box.textContent = pageUrl; }
    box.dataset.done='1';
  }
  if(dlg.showModal) dlg.showModal(); else dlg.setAttribute('open','');
});
$('dlg-close').addEventListener('click',()=>dlg.close ? dlg.close() : dlg.removeAttribute('open'));
dlg.addEventListener('click',e=>{ if(e.target===dlg) dlg.close(); });

/* compartilhar */
$('btn-share').addEventListener('click',async()=>{
  const data={title:'Léo Vasconcellos · LeadVox',text:'Meu cartão digital',url:pageUrl};
  if(navigator.share){ try{ await navigator.share(data); }catch(e){} return; }
  try{ await navigator.clipboard.writeText(pageUrl); }catch(e){}
  const t=$('toast'); t.classList.add('on'); setTimeout(()=>t.classList.remove('on'),1800);
});
</script>
</body>
</html>
